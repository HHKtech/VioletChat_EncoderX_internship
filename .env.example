# PostgreSQL connection string used by Drizzle ORM
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Secret used to sign/verify JWTs. Generate a long random value for production,
# e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-secret

# JWT lifetime (jsonwebtoken "expiresIn" format)
JWT_EXPIRES_IN=7d

# Name of the httpOnly auth cookie
COOKIE_NAME=violetchat_token

NODE_ENV=development

# Port the custom Node/Next.js + Socket.IO server listens on
PORT=3000

# Comma separated list of origins allowed to call the API / open a socket
# connection. Add your deployed frontend URL(s) in production.
ALLOWED_ORIGINS=http://localhost:3000

NEXT_PUBLIC_SOCKET_URL=https://violetchat-server.alwaysdata.net